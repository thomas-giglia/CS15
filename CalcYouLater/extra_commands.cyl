% Basic execution of an rstring
{ 42 print }
exec  
% Should print 42

% Nested rstring execution (1 level deep)
{ { 99 print } exec }
exec  
% Should print 99

% Multi-step execution (nested arithmetic)
{ 10 20 + { 30 40 + { 50 60 + print } exec print } exec print }
exec  
% Should print 110, then 70, then 30

% Deeply nested execution (4 levels deep)
{ { { { 777 print } exec } exec } exec }
exec  
% Should print 777

% Stack manipulation inside an rstring
{ 5 10 swap printStack }
exec 
% Should print 10, then 5

% Executing arithmetic inside an rstring
{ 3 4 + 2 * print }
exec  
% Should print 14

% Multi-step execution with stack manipulation
{ 1 2 3 { swap printStack } exec printStack }
exec  
% Should print:
% 2 1 3 (inside rstring execution)
% 3 2 1 (final stack state)

% Conditional execution inside an rstring
#t
{ { 100 print } { 200 print } if }
exec  
% Should print 100

#f
{ { 300 print } { 400 print } if }
exec  
% Should print 400

% Multi-step execution with nested conditionals
#t
{ #t { 999 print } { 888 print } if }
{ #f { 777 print } { 666 print } if }
if  
% Should print 999

% Executing a sequence of rstrings with embedded arithmetic
{ 2 3 + { 4 5 + { 6 7 + { 8 9 + print } exec print } exec print } exec print }
exec  
% Should print 17, then 13, then 9, then 5

% Self-referential execution (a stored rstring that executes itself once)
{ { "Hello from recursive exec!" print } exec }
exec  
% Should print "Hello from recursive exec!"

% Complex execution with conditional logic
{ 5 10 > 
    { "5 is greater than 10 (should not print)" print } 
    { "5 is NOT greater than 10 (should print)" print } 
if }
exec  
% Should print "5 is NOT greater than 10"

% Multi-step conditional execution inside an rstring
{ 50 100 < 
    { 25 5 * print } 
    { 10 2 * print } 
if }
exec  
% Should print 125

% Recursively executing rstring (controlled recursion)
{ { "First execution" print { "Second execution" print } exec } exec }
exec  
% Should print "First execution" then "Second execution"

% Even deeper multi-step execution
{ 5 5 + { 10 2 * { 30 3 / { 4 4 * print } exec print } exec print } exec print }
exec  
% Should print 16, then 10, then 20, then 30
